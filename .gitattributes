# LF line endings on every checkout, Windows included: golden files, hash vectors, generated
# documents and parsers compare text byte for byte (spec 014, R1). Binary files are detected
# and left alone.
* text=auto eol=lf

# Fluent fixtures and their now-sdk output are compared byte for byte on every platform (spike
# S13, test A3): keep LF line endings on Windows checkouts too.
tests/fixtures/fluent/** text eol=lf
tests/fixtures/fluent-errors/** text eol=lf
