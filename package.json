{
  "name": "snagentic-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "arch": "bun scripts/arch.ts",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun run arch && bun test --coverage",
    "build": "bun build packages/cli/src/main.ts --compile --minify --outfile dist/snagentic"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "^6"
  }
}
